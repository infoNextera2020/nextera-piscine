{
  "name": "nextera-piscine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @nextera/web dev",
    "build": "pnpm --filter @nextera/domain build && pnpm --filter @nextera/db build && pnpm --filter @nextera/web build",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive --if-present typecheck && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:db": "vitest run --config packages/db/vitest.integration.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @nextera/db db:generate",
    "db:migrate": "pnpm --filter @nextera/db db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
