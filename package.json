{
  "name": "nextera-piscine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @nextera/web dev",
    "build": "pnpm --filter @nextera/domain build && pnpm --filter @nextera/db build && pnpm --filter @nextera/web build",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive --if-present typecheck && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:db": "vitest run --config packages/db/vitest.integration.config.ts",
    "test:auth": "playwright test tests/e2e/identity-access.spec.ts",
    "test:curriculum": "vitest run scripts/curriculum/tests",
    "test:cohorts": "playwright test tests/e2e/cohort-enrollment.spec.ts",
    "test:submissions": "tsx scripts/test-local-judge.ts",
    "judge:fixture": "tsx scripts/local-judge-fixture.ts",
    "judge:local": "tsx scripts/local-judge.ts",
    "judge:maintenance": "tsx scripts/judge-maintenance.ts",
    "curriculum:validate": "tsx scripts/curriculum.ts validate",
    "curriculum:import": "tsx scripts/curriculum.ts draft",
    "curriculum:publish": "tsx scripts/curriculum.ts publish",
    "cohort:create": "tsx scripts/cohort.ts create",
    "cohort:list": "tsx scripts/cohort.ts list",
    "cohort:pin": "tsx scripts/cohort.ts pin",
    "cohort:enroll": "tsx scripts/cohort.ts enroll",
    "supabase:start": "supabase start --network-id nextera-piscine-local",
    "supabase:stop": "supabase stop",
    "local:env": "tsx scripts/local-env.ts",
    "local:provision": "tsx scripts/provision-user.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @nextera/db db:generate",
    "db:migrate": "pnpm --filter @nextera/db db:migrate"
  },
  "devDependencies": {
    "@nextera/db": "workspace:*",
    "@nextera/domain": "workspace:*",
    "@playwright/test": "1.64.1",
    "@supabase/supabase-js": "2.118.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@types/node": "24.19.2",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "eslint": "10.13.0",
    "postgres": "3.4.9",
    "supabase": "2.121.0",
    "tsx": "4.23.15",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
