# Server-only runtime connection. Use the Supabase transaction pooler for web hosting.
DATABASE_URL=

# Server-only migration connection: direct PostgreSQL or Supabase session pooler.
# This identity must own migrations; never use it for web requests.
MIGRATION_DATABASE_URL=

# Controlled publication/enrollment tooling only; never pass to the web process.
# Use an explicitly provisioned operational identity, separate from runtime credentials.
OPERATIONS_DATABASE_URL=

# Dedicated disposable PostgreSQL database for integration tests. Never production.
TEST_DATABASE_URL=

# Public Auth configuration; these are the only Supabase values allowed in client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local provisioning/E2E tooling only. Never copy these into apps/web or deployments.
SUPABASE_LOCAL_URL=
SUPABASE_LOCAL_SERVICE_ROLE_KEY=
# Dedicated maintenance permission role; never supplied to web or learner containers.
MAINTENANCE_DATABASE_URL=
# Runner-only variables live in its protected environment, outside apps/web.
JUDGE_DATABASE_URL=
JUDGE_STORAGE_PUBLISHABLE_KEY=
# Dedicated trusted product application (server/scheduler only; never NEXT_PUBLIC).
RESULT_APPLICATION_DATABASE_URL=
RESULT_APPLICATION_SERVICE_TOKEN=
